# syntax=docker/dockerfile:1

# Construye el frontend y lo empaqueta junto al Nginx de borde,
# para que edge.conf pueda servir los estáticos directamente.
FROM node:20-alpine AS web-builder
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter web
COPY apps/web apps/web
RUN pnpm --filter web build

FROM nginx:1.27-alpine
COPY infra/nginx/edge.conf /etc/nginx/conf.d/default.conf
COPY infra/nginx/proxy_params_api.conf /etc/nginx/proxy_params_api.conf
COPY --from=web-builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s CMD wget -q --spider http://localhost/health || exit 1
