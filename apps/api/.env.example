NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5432/erp_retail?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=CAMBIAR_EN_PRODUCCION_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CAMBIAR_EN_PRODUCCION_MIN_32_CHARS_DIFERENTE
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

COOKIE_SECRET=CAMBIAR_EN_PRODUCCION_MIN_32_CHARS

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=erp-retail
S3_ACCESS_KEY=erp_admin
S3_SECRET_KEY=erp_dev_password

AES_ENCRYPTION_KEY=CAMBIAR_EN_PRODUCCION_MIN_32_CHARS_AES
