{
  "name": "api",
  "version": "1.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "build": "nest build",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:concurrencia": "jest --config ./test/jest-e2e.json --testPathPattern=concurrencia",
    "test:smoke": "jest --config ./test/jest-e2e.json --testPathPattern=smoke"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
