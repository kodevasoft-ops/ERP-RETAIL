NODE_ENV=production
PORT=3000

# En producción, la app se conecta a PgBouncer (pool multiplexado), no directo a Postgres.
DATABASE_URL="postgresql://postgres:Admin3312@localhost:5432/erp_retail?schema=public"
DB_POOL_SIZE=5

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=GENERAR_CON_openssl_rand_-base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GENERAR_OTRO_DIFERENTE
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=https://tu-dominio.com

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

COOKIE_SECRET=GENERAR_CON_openssl_rand_-base64_48

# Cloudflare R2 (S3-compatible, sin costo de egress)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=erp-retail-fotos
S3_ACCESS_KEY=CAMBIAR
S3_SECRET_KEY=CAMBIAR
S3_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

AES_ENCRYPTION_KEY=GENERAR_CON_openssl_rand_-base64_48

DB_PASSWORD=CAMBIAR_PASSWORD
